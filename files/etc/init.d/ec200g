#!/bin/sh /etc/rc.common
# 板载 EC200G-CN（Cat 1）服务
#
# 硬件事实（实机确认）：
#   - EC200G 挂在 uart2 = /dev/ttyS2 @115200，**不在 USB 上**
#   - 它由外挂 MCU 的 modem2 供电；MCU 在 uart1 = /dev/ttyS1，**57600**
#   - MCU 帧格式：7E | len(2B)=0x000A | cmd(2B)=0x0044 | mask(2B) | value(2B) | cksum(2B) | 7E
#     cksum = 前面各字节的 16 位算术和；转义规则 0x7D + (原字节 XOR 0x7D)
#     modem2 上电 = mask 0x3028 / value 0x0020，断电 = mask 0x0028 / value 0x0008
#
# 通道划分（内核 n_gsm CMUX）：
#   /dev/gsmtty1 → pppd 数据面
#   /dev/gsmtty2 → QModem 的 AT / 短信
#   /dev/gsmtty3 → 备用
#
# 曾经踩过的坑，改动都在下面标了【坑N】：
#  【坑1】/dev/ttyS1 默认是 9600。不显式设成 57600，发出去的 MCU 帧全是乱码，
#         模组根本不上电——表现为"AT 无应答，放弃"。
#  【坑2】gsmtty 是带载波语义的 tty，最后一个使用者关闭就拆 DLCI。
#         tom_modem 用阻塞式 open，第二次调用起必然卡死在等载波。
#         对策：gsm-hold 常驻按住每条通道。
#  【坑3】tom_modem 在 /dev/shm 放 pthread 互斥锁，被 SIGKILL 打断会留下
#         永久锁死的锁文件，之后所有 tom_modem 在 futex 上死等。开机先清掉。
#  【坑4】QModem"AT 调试"的端口下拉框只遍历后端给的 other_ttys，而后端只 glob
#         ttyUSB/ttyACM/mhi_DUN/wwanNatN，认不得 /dev/gsmttyN，于是本模组
#         在那个页面上一个可用端口都没有。见 qmodem-atports-patch。
#  【坑5】QModem 自己也有一套拨号后端。一旦 qmodem.ec200g.enable_dial 被置 1，
#         modem_dial.sh 会和 netifd 的 pppd 抢同一个模组：它发 AT+CGACT?、
#         挂断重拨，把 pppd 打断（No response to 3 echo-requests -> Modem hangup），
#         期间 AT 端口被两个主人轮番占用，SIM 查询超时，界面上就从 READY 变成 MIS。
#         本机的拨号一律由 netifd(proto=ppp) 负责，所以每次开机强制置 0。

START=50
STOP=89
USE_PROCD=1

UART=/dev/ttyS2
MCU=/dev/ttyS1
MCU_BAUD=57600
BAUD=115200
IFACE=wwan4g
APN=cmnet
AT_CH=/dev/gsmtty2
DATA_CH=/dev/gsmtty1
HOLD_CH="1 2 3"

# ---------- MCU 供电控制 ----------
# 用 printf 直接拼帧，不依赖任何外部工具
mcu_frame() {
	# $1=mask(hex4)  $2=value(hex4)
	local m=$((0x$1)) v=$((0x$2))
	local mh=$(((m >> 8) & 255)) ml=$((m & 255))
	local vh=$(((v >> 8) & 255)) vl=$((v & 255))
	local ck=$((0x0a + 0x44 + mh + ml + vh + vl))
	local ch=$(((ck >> 8) & 255)) cl=$((ck & 255))
	local b out=""
	for b in 0 10 0 68 $mh $ml $vh $vl $ch $cl; do
		if [ "$b" -eq 126 ] || [ "$b" -eq 125 ]; then
			out="$out\\$(printf '%03o' 125)\\$(printf '%03o' $((b ^ 125)))"
		else
			out="$out\\$(printf '%03o' $b)"
		fi
	done
	printf "\\176${out}\\176" > "$MCU"
}

# 【坑1】每次发帧前都确保串口速率对
mcu_init() {
	[ -e "$MCU" ] || return 1
	stty -F "$MCU" $MCU_BAUD clocal raw -echo -crtscts 2>/dev/null
}

modem2_on()  { mcu_init; mcu_frame 0028 0008; sleep 1; mcu_frame 3028 0020; }
modem2_off() { mcu_init; mcu_frame 0028 0008; }

# 直接用 shell 收发，绕开 tom_modem——上电阶段它的锁和阻塞 open 都是风险
modem_alive() {
	local dev="$1" out
	stty -F "$dev" $BAUD clocal raw -echo -crtscts 2>/dev/null || return 1
	cat "$dev" > /tmp/.ec200g_probe 2>/dev/null &
	local cp=$!
	sleep 1
	printf 'AT\r' > "$dev" 2>/dev/null
	sleep 2
	kill $cp 2>/dev/null
	grep -q "OK" /tmp/.ec200g_probe 2>/dev/null
}

start_service() {
	[ -e "$UART" ] || return 0

	# 【坑3】清掉上次残留的 tom_modem 互斥锁
	rm -f /dev/shm/tom_modem_lock_* 2>/dev/null

	# 【坑4】QModem 的 AT 调试下拉框只列 ttyUSB/ttyACM/mhi_DUN/wwanNatN，
	# 认不得 CMUX 的 /dev/gsmttyN。补丁是幂等的，每次开机跑一遍，
	# 这样即使 apk 升级把 qmodem 覆盖回去，下次重启也会自动补上。
	[ -x /usr/sbin/qmodem-atports-patch ] && /usr/sbin/qmodem-atports-patch

	# 【坑5】拨号只能有一个主人。QModem 的拨号后端一旦被打开（界面上误点、
	# 或 qmodem.main.enable_dial 的全局默认扩散过来），就会和 pppd 抢模组，
	# 表现为 PPP 反复掉线重连、SIM 状态在 READY 与 MIS 之间跳。每次开机纠正。
	if [ "$(uci -q get qmodem.ec200g.enable_dial)" != "0" ]; then
		uci -q set qmodem.ec200g.enable_dial=0
		uci -q commit qmodem
		logger -t ec200g "已关闭 QModem 对 ec200g 的拨号（拨号由 netifd/pppd 负责）"
	fi

	logger -t ec200g "给板载 Cat 1 模组上电（MCU @${MCU_BAUD}）"
	modem2_on

	local n=0
	while [ $n -lt 60 ]; do
		modem_alive "$UART" && break
		n=$((n + 3)); sleep 3
	done
	if ! modem_alive "$UART"; then
		logger -t ec200g "模组在 60 秒内没有应答，放弃"
		return 0
	fi
	logger -t ec200g "模组已就绪（t+${n}s）"

	# 不发 AT+CGDCONT：模组出厂就是 IPV4V6/cmnet，够用；
	# 而且 PDP 已激活时改它会回 CME ERROR。

	if [ -x /usr/sbin/gsmmux ] && grep -q gsm /proc/tty/ldiscs 2>/dev/null; then
		logger -t ec200g "启用内核 CMUX"
		procd_open_instance gsmmux
		procd_set_param command /usr/sbin/gsmmux -b $BAUD -n 4 -m 512 "$UART"
		procd_set_param respawn 30 10 0
		procd_set_param stdout 1
		procd_set_param stderr 1
		procd_close_instance

		# 【坑2】每条通道一个常驻持有者，DLCI 才不会被拆掉
		local ch
		for ch in $HOLD_CH; do
			procd_open_instance hold$ch
			procd_set_param command /usr/sbin/gsm-hold /dev/gsmtty$ch
			procd_set_param respawn 30 5 0
			procd_close_instance
		done
	else
		logger -t ec200g "内核 CMUX 不可用，退回直连模式"
	fi
}

service_started() {
	local n=0

	while [ $n -lt 25 ]; do
		[ -e "$AT_CH" ] && [ -e "$DATA_CH" ] && break
		n=$((n + 1)); sleep 1
	done

	if [ -e "$AT_CH" ] && [ -e "$DATA_CH" ]; then
		# 保险起见自己也设一遍 clocal，不依赖 gsm-hold 的先后顺序
		local ch
		for ch in $HOLD_CH; do
			stty -F /dev/gsmtty$ch clocal raw -echo -crtscts 2>/dev/null
		done
		logger -t ec200g "CMUX 通道就绪"
		uci -q set network.$IFACE.device="$DATA_CH"
		uci -q set qmodem.ec200g.at_port="$AT_CH"
		uci -q set qmodem.ec200g.sms_at_port="$AT_CH"
		uci -q delete qmodem.ec200g.valid_at_ports
		uci -q add_list qmodem.ec200g.valid_at_ports="$AT_CH"
		# gsmtty3 是空闲的备用通道，AT 实测可用，一并登记为有效口；
		# gsmtty1 故意不登记——它被 pppd 占着跑 PPP 帧，发 AT 不会有回应，
		# 页面会把它标成 (invalid)，这正是我们要的提示。
		uci -q add_list qmodem.ec200g.valid_at_ports='/dev/gsmtty3'
		# QModem 的"AT 调试"下拉是从 ports 取的。首刷时这里还是 /dev/ttyS2，
		# 而 ttyS2 此刻已被 gsmmux 独占，选它发命令只会拿到 EOF。
		uci -q delete qmodem.ec200g.ports
		for ch in $HOLD_CH; do
			uci -q add_list qmodem.ec200g.ports="/dev/gsmtty$ch"
		done
		uci -q commit network
		uci -q commit qmodem

		# 等 gsm-hold 真正按住通道再拨号。
		# 注意：这里只能查进程，绝不能去读 /proc/*/fd/8 —— 那等于读串口，会卡住。
		n=0
		while [ $n -lt 20 ]; do
			pgrep -f "gsm-hold $AT_CH" >/dev/null 2>&1 && break
			n=$((n + 1)); sleep 1
		done
		sleep 3
	else
		logger -t ec200g "没有 CMUX 通道，数据面与 AT 都走 $UART（二者互斥）"
		uci -q set network.$IFACE.device="$UART"
		uci -q set qmodem.ec200g.at_port="$UART"
		uci -q set qmodem.ec200g.sms_at_port="$UART"
		uci -q commit network
		uci -q commit qmodem
		sleep 3
	fi

	local i=1
	while [ $i -le 3 ]; do
		logger -t ec200g "拉起 $IFACE（第 $i 次）"
		ifup "$IFACE"
		local w=0
		while [ $w -lt 30 ]; do
			if ip -4 addr show "ppp-$IFACE" 2>/dev/null | grep -q "inet "; then
				logger -t ec200g "$IFACE 已连接"
				# ppp-wwan4g 此刻才存在，重扫一次让 4G 指示灯绑上去
				/etc/init.d/led restart >/dev/null 2>&1
				return 0
			fi
			w=$((w + 1)); sleep 1
		done
		i=$((i + 1)); sleep 5
	done
	logger -t ec200g "$IFACE 三次拉起均失败，见 logread"
}

stop_service() {
	ifdown "$IFACE" 2>/dev/null
	killall pppd 2>/dev/null
}

# 供人工排障：/etc/init.d/ec200g power_cycle
power_cycle() {
	echo "断电 modem2..."
	modem2_off; sleep 6
	echo "上电 modem2..."
	modem2_on
	echo "完成。等约 20 秒模组启动。"
}

EXTRA_COMMANDS="power_cycle"
EXTRA_HELP="	power_cycle	用 MCU 给板载 Cat 1 模组断电重启"
