#!/bin/sh
# 修 LuCI 无线页面对联发科私有驱动（type=mtwifi）的两处问题。
#
# 目标文件：/www/luci-static/resources/view/network/wireless.js
#           （luci-mod-network 提供，已压缩）
#
# ── 问题一：加密方式下拉框只有"无加密" ────────────────────────────
#   加密候选是这样攒出来的：
#       const crypto_modes=[];
#       if (hwtype=='mac80211') { ...psk2/psk/psk-mixed/sae/owe/wpa2... }
#       else if (hwtype=='broadcom') { ...psk2/psk/wep... }
#       crypto_modes.push(['none','No Encryption',0]);
#   上游只认 mac80211 和 broadcom。本机 radio 是 type='mtwifi'，两个分支都不进，
#   只剩公共段那条 none。
#   驱动侧本身完全支持，见 /usr/share/schema/mtwifi/dat-defs.json 的 ENC_2_DAT。
#
#   修法：在 mac80211 分支前插一个 mtwifi 分支，**只放 ENC_2_DAT 里真实存在的
#   那几种**。刻意不照抄 mac80211 分支——那里还有 WPA-EAP / WPA3-EAP / WEP，
#   驱动不认，转换时会静默回落成 OPEN/NONE，选得到却不生效，比没有更糟。
#
# ── 问题二：在该页面保存会把射频配置清空 ─────────────────────────
#   页面上的"工作频率"控件 CBIWifiFrequencyValue（选项名 _freq）负责读写
#   band / channel / htmode 三个字段。它是按 mac80211 的能力模型写的，
#   对 mtwifi 拿不到匹配的 hwmode/htmode 组合，保存时会把这三个字段一并清掉。
#
#   实测后果：uci 里 band/channel/htmode 全没了，驱动停在
#   Channel 0 / Tx-Power 0 dBm，两个 SSID 都不再开播（页面显示"无线未关联"）。
#   注意加密本身是写对了的（AuthMode=WPA2PSKWPA3PSK），坏的只是频率这一块。
#
#   修法：对 mtwifi 把这个控件改成只读（write/remove 变成空操作），
#   这样在页面上改 SSID、加密、密码都不会再动到 band/channel/htmode。
#   代价是 mtwifi 的信道与带宽不能在这个页面上改了——但原本它也改不对，
#   要改请走 SSH：
#       uci set wireless.MT7981_1_2.channel=149   # auto 或具体信道
#       uci set wireless.MT7981_1_2.htmode=HE80
#       uci commit wireless && wifi reload
#   另外 /etc/init.d/p3-uipatch 里还有一道开机兜底，万一这三个字段又空了，
#   下次重启会自动补回来。
#
# 两处改动各自带独立标记，互不影响，可分别重复执行。
# 都有：锚点唯一性检查、备份、结构自检，不通过就不动原文件。

F=/www/luci-static/resources/view/network/wireless.js
[ -f "$F" ] || exit 0
rc=0

backup_once() {
	[ -f "$F.encorig" ] || cat "$F" > "$F.encorig" 2>/dev/null
}

# ── 改动一：加密候选 ───────────────────────────────────────────
MARK1=mtwifi_enc_patched
A1="const crypto_modes=\[\];if(hwtype=='mac80211')"
N1="const crypto_modes=[];/*${MARK1}*/if(hwtype=='mtwifi'){crypto_modes.push(['psk2','WPA2-PSK',35]);crypto_modes.push(['sae','WPA3-SAE',31]);crypto_modes.push(['sae-mixed','WPA2-PSK/WPA3-SAE Mixed Mode',30]);crypto_modes.push(['psk-mixed','WPA-PSK/WPA2-PSK Mixed Mode',22]);crypto_modes.push(['psk','WPA-PSK',12]);crypto_modes.push(['owe','OWE',1]);}else if(hwtype=='mac80211')"

if ! grep -q "$MARK1" "$F"; then
	if [ "$(grep -c "$A1" "$F")" = "1" ]; then
		sed "s|${A1}|${N1}|" "$F" > "$F.new1"
		if grep -q "$MARK1" "$F.new1" &&
		   grep -q "else if(hwtype=='mac80211')" "$F.new1" &&
		   grep -q "crypto_modes.push(\['none'" "$F.new1"; then
			backup_once; cat "$F.new1" > "$F"; rm -f "$F.new1"
			logger -t mtwifi-ui "已加上 mtwifi 加密选项"
		else
			rm -f "$F.new1"; logger -t mtwifi-ui "加密改动自检未过，跳过"; rc=1
		fi
	else
		logger -t mtwifi-ui "加密锚点不唯一或不存在，跳过（luci-mod-network 可能已升级）"
	fi
fi

# ── 改动二：频率控件对 mtwifi 只读 ─────────────────────────────
MARK2=mtwifi_freq_guard
A2="reported as such.'));o.ucisection=s.section;"
N2="reported as such.'));o.ucisection=s.section;/*${MARK2}*/if(hwtype=='mtwifi'){o.write=function(){};o.remove=function(){};}"

if ! grep -q "$MARK2" "$F"; then
	if [ "$(grep -c "$A2" "$F")" = "1" ]; then
		sed "s|${A2}|${N2}|" "$F" > "$F.new2"
		if grep -q "$MARK2" "$F.new2" &&
		   grep -q "CBIWifiFrequencyValue,'_freq'" "$F.new2"; then
			backup_once; cat "$F.new2" > "$F"; rm -f "$F.new2"
			logger -t mtwifi-ui "已把频率控件对 mtwifi 设为只读"
		else
			rm -f "$F.new2"; logger -t mtwifi-ui "频率改动自检未过，跳过"; rc=1
		fi
	else
		logger -t mtwifi-ui "频率锚点不唯一或不存在，跳过（luci-mod-network 可能已升级）"
	fi
fi

exit $rc
