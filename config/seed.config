# ============================================================
# FZS 5GCPE P3 (fzs,5gcpe-p3) 编译配置
#
# 基线一：上游仓库自带的 defconfig/mt7981-ax3000.config
#         —— 提供 MTK 无线驱动栈的上百个 Kconfig 选项
#            （CONNINFRA/CHIP_MT7981/EEPROM/DBDC…）。
#            这些不是软件包，从镜像的包清单里反推不出来；
#            缺了它们 conninfra 会以 "apconninfra_of_ids undefined" 编译失败。
#
# 基线二：iniwex 参考镜像的 342 个软件包（逐个从其 apk 数据库提取）
#
# 增补：CONFIG_N_GSM（内核 CMUX，在 workflow 里写进 target 的 kernel config）
#       以及 EC200G 拨号与排障所需的少量工具
# ============================================================

# ---------- 来自上游 MT7981 defconfig ----------
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
