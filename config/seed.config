# ============================================================
# FZS 5GCPE P3 (fzs,5gcpe-p3) 编译配置
#
# 基线：iniwex 的 immortalwrt-25.12-snapshot-...-p3-squashfs-sysupgrade.bin
#       共 342 个软件包，逐个从镜像的 apk 数据库中提取
# 增补：CONFIG_N_GSM（内核 CMUX，见 target/linux 的 kernel config 追加）
#       以及 EC200G 所需的少量工具
# ============================================================

# ---------- 目标平台与机型 ----------
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_mediatek_filogic_DEVICE_fzs_5gcpe-p3=y

# ---------- 镜像格式 ----------
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_TARGET_ROOTFS_INITRAMFS=n

# ---------- 语言 ----------
CONFIG_LUCI_LANG_zh_Hans=y

# ---------- 复刻参考镜像的 342 个软件包 ----------
CONFIG_PACKAGE_apk-openssl=y
CONFIG_PACKAGE_autocore=y
CONFIG_PACKAGE_automount=y
