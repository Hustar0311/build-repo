# ---------- AT 串口串行化补丁的硬依赖 ----------
# qmodem-atlock-patch 把 tom_modem 包一层 flock，把同一个 AT 口上的并发
# 查询排成队（见坑 8）。没有 flock 的话补丁只会静默跳过，症状会悄悄回来，
# 所以这里显式固定，不吃上游 defconfig 的默认值。
# 实机 /usr/bin/flock 来自 busybox，因此固定 busybox 的 applet。
CONFIG_BUSYBOX_CONFIG_FLOCK=y
